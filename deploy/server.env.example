# Save a filled copy OUTSIDE the repository; use docker compose --env-file /etc/jobcompass/server.env.
JOBCOMPASS_PUBLIC_ORIGIN=https://jobs.example.com
JOBCOMPASS_ALLOWED_HOSTS=jobs.example.com
# Exact source IP seen by the app for your own reverse proxy. Blank means ignore forwarded headers.
JOBCOMPASS_TRUSTED_PROXIES=
JOBCOMPASS_SESSION_TTL=3600
JOBCOMPASS_MAX_SESSIONS=32
JOBCOMPASS_SESSION_PER_IP=12
JOBCOMPASS_SESSION_GLOBAL=120
# Optional exact, operator-approved domains for custom HTTPS page collection; blank disables it publicly.
# JobsDB updates, fixed API sources and file imports remain available.
JOBCOMPASS_PAGE_HOSTS=
JOBCOMPASS_AI_PER_IP=10
JOBCOMPASS_AI_GLOBAL=100
JOBCOMPASS_AI_ACTIVE=3
JOBCOMPASS_RECOMMEND_ACTIVE=3
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional research overlay only:
JOBCOMPASS_RESEARCH_SOURCE=/srv/jobcompass/research/jobsdb.sqlite
